{% extends 'base.html.twig' %}
{% block body %}

<div class="ml-64 p-6">
    <div class="max-w-2xl mx-auto bg-white shadow-lg rounded-xl p-6">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Ajouter une vidéo</h2>
        
        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
        
        <div>
            {{ form_label(form.title, null, {'attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full mt-1 px-4 py-2 border rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500'}}) }}
            {{ form_errors(form.title, {'attr': {'class': 'text-red-500 text-sm'}}) }}
        </div>

        <div>
            {{ form_label(form.url, null, {'attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.url, {'attr': {'class': 'w-full mt-1 px-4 py-2 border rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500'}}) }}
            {{ form_errors(form.url, {'attr': {'class': 'text-red-500 text-sm'}}) }}
        </div>

        <div>
            {{ form_label(form.description, null, {'attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'w-full mt-1 px-4 py-2 border rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500'}}) }}
            {{ form_errors(form.description, {'attr': {'class': 'text-red-500 text-sm'}}) }}
        </div>

        <button type="submit" class="w-full bg-indigo-600 text-white font-semibold py-2 px-4 rounded-lg shadow-md hover:bg-indigo-700 transition duration-300">
            Enregistrer
        </button>
        
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
