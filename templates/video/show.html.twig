{% extends 'base.html.twig' %}

{% block body %}
<div class="ml-64 p-4">
    <div class="container mx-auto p-4">
        <h1 class="text-3xl font-semibold">{{ video.title }}</h1>
        <!-- Afficher la vignette -->
        <img src="{{ video.thumbnail }}" alt="Thumbnail de la vidéo" class="w-full h-auto mb-4">
        <!-- Afficher l'iframe de la vidéo -->
        <iframe width="560" height="315" src="{{ video.url }}" frameborder="0" allowfullscreen></iframe>
    </div>
</div>
{% endblock %}