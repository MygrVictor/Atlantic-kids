{% extends 'base.html.twig' %}

{% block body %}
<div class="ml-64 p-4">
    <div class="container mx-auto p-4">
        <h1 class="text-3xl font-semibold mb-8">Toutes les vidéos</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for video in videos %}
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <!-- Afficher la vignette -->
                    <img src="{{ video.thumbnail }}" alt="Thumbnail de la vidéo" class="w-full h-64 object-cover">
                    <div class="p-4">
                        <h2 class="text-2xl font-semibold">{{ video.title }}</h2>
                        <a href="{{ path('video_show', {'id': video.id}) }}" class="text-blue-500 hover:text-blue-700 mt-2 inline-block">Voir la vidéo</a>
                    </div>
                </div>
            {% else %}
                <p>Aucune vidéo trouvée.</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
