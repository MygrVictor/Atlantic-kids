{% extends 'base.html.twig' %}

{% block title %}Déconnexion{% endblock %}

{% block body %}
    <div class="flex items-center justify-center min-h-screen bg-gray-100">
        <div class="p-6 bg-white shadow-md rounded-lg text-center">
            <h1 class="text-2xl font-bold mb-4">Vous avez été déconnecté</h1>
            <p class="mb-4">Merci d'avoir utilisé notre service. Vous pouvez vous reconnecter à tout moment.</p>
            <a href="{{ path('app_login') }}" class="px-4 py-2 text-white bg-blue-500 rounded-lg hover:bg-blue-600">Se reconnecter</a>
        </div>
    </div>
{% endblock %}
