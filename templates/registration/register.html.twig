{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-gray-100">
        <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-lg">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger bg-red-100 text-red-700 p-4 mb-4 rounded-md">
                    {{ flash_error }}
                </div>
            {% endfor %}

            <h1 class="text-2xl font-semibold text-center mb-6">Register</h1>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
                <div class="mb-4">
                    {{ form_row(registrationForm.email, {
                        'attr': {'class': 'w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500'}
                    }) }}
                </div>

                <div class="mb-4">
                    {{ form_row(registrationForm.plainPassword, {
                        'label': 'Password',
                        'attr': {'class': 'w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500'}
                    }) }}
                </div>

                <div class="mb-4">
                    {{ form_row(registrationForm.agreeTerms, {
                        'attr': {'class': 'w-4 h-4 text-blue-500 focus:ring-blue-500'}
                    }) }}
                </div>

                <div class="text-center">
                    <button type="submit" class="w-full bg-blue-500 text-white p-2 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Register
                    </button>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
