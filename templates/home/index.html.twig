{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="ml-64 p-4">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-4">
    {% for item in content %}
        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
            
            {% if item.type == 'video' %}
                <!-- Afficher la vidéo -->
                <img src="{{ item.thumbnail }}" alt="Thumbnail de la vidéo" class="w-full h-64 object-cover">
                <div class="p-4">
                    <h2 class="text-2xl font-semibold">{{ item.title }}</h2>
                    <p class="text-sm text-gray-600 mt-2"><strong>Publiée le :</strong> {{ item.createdAt|date('d/m/Y') }}</p>
                    <a href="{{ path('video_show', {'id': item.id}) }}" class="text-blue-500 hover:text-blue-700 mt-2 inline-block">Voir la vidéo</a>
                </div>

            {% elseif item.type == 'article' %}
                <!-- Afficher l'article -->
                {% if item.image %}
                    <img src="{{ asset('uploads/images/' ~ item.image) }}" alt="Image de l'article" class="w-full h-64 object-cover">
                {% endif %}
                <div class="p-4">
                    <h2 class="text-2xl font-semibold">{{ item.title }}</h2>
                    <p class="text-sm text-gray-600 mt-2"><strong>Auteur :</strong> {{ item.user.username }}</p>
                    <p class="text-sm text-gray-600"><strong>Date de publication :</strong> {{ item.createdAt|date('d/m/Y') }}</p>
                    <p class="text-gray-700 mt-4">
                        {{ item.content|slice(0, 150) }}... 
                        <a href="{{ path('article_show', {id: item.id}) }}" class="text-blue-500 hover:text-blue-700">Lire la suite</a>
                    </p>
                </div>
            {% endif %} <!-- Fin du test article/vidéo -->

        </div> <!-- Fin du div de l'item -->
    {% endfor %} <!-- Fin de la boucle -->
</div>
</div>
{% endblock %}
