{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    <div class="max-w-4xl mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Contactez-nous</h1>

        {% for message in app.flashes('success') %}
            <div class="bg-green-100 border-t-4 border-green-500 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
                <strong class="font-bold">Succès !</strong>
                <span class="block sm:inline">{{ message }}</span>
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

        <div class="flex flex-col space-y-4">
            <div>
                {{ form_label(form.name, null, {'attr': {'class': 'text-lg font-medium text-gray-700'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'}}) }}
                {{ form_errors(form.name, {'attr': {'class': 'text-sm text-red-500'}}) }}
            </div>

            <div>
                {{ form_label(form.email, null, {'attr': {'class': 'text-lg font-medium text-gray-700'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400'}}) }}
                {{ form_errors(form.email, {'attr': {'class': 'text-sm text-red-500'}}) }}
            </div>

            <div>
                {{ form_label(form.message, null, {'attr': {'class': 'text-lg font-medium text-gray-700'}}) }}
                {{ form_widget(form.message, {'attr': {'class': 'w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 h-40'}}) }}
                {{ form_errors(form.message, {'attr': {'class': 'text-sm text-red-500'}}) }}
            </div>

            <div class="text-center">
                <button type="submit" class="w-full bg-blue-500 text-white py-3 px-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 hover:bg-blue-600">
                    Envoyer
                </button>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
