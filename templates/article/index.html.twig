{% extends 'base.html.twig' %}

{% block body %}
<div class="ml-64 p-4">
    <h1 class="text-3xl font-semibold text-center my-8">Tous les Articles</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-4">
        {% for article in articles %}
        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
            <!-- Image de l'article -->
            {% if article.image %}
                <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="Image de l'article" class="w-full h-64 object-cover">
            {% endif %}

            <div class="p-4">
                <!-- Titre de l'article -->
                <h2 class="text-2xl font-semibold text-gray-800">{{ article.title }}</h2>

                <!-- Auteur et date -->
                <p class="text-sm text-gray-600 mt-2">
                    <strong>Auteur :</strong> {{ article.user.username }}
                </p>
                <p class="text-sm text-gray-600">
                    <strong>Date de publication :</strong> {{ article.createdAt|date('d/m/Y') }}
                </p>

                <!-- Contenu de l'article -->
                <p class="text-gray-700 mt-4">{{ article.content|slice(0, 150) }}...
                    <a href="{{ path('article_show', {id: article.id}) }}" class="text-blue-500 hover:text-blue-700">Lire la suite</a>
                </p>

                <!-- Tags de l'article -->
                {% if article.tags is not empty %}
                    <div class="mt-4">
                        <strong>Tags :</strong>
                        <div class="flex flex-wrap mt-2">
                            {% for tag in article.tags %}
                                <span class="bg-blue-100 text-blue-800 text-xs font-semibold mr-2 px-2.5 py-0.5 rounded">{{ tag.name }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- Nombre de likes -->
                <p class="text-sm text-gray-600 mt-2">
                    <strong>Likes :</strong> <span id="like-count-{{ article.id }}">{{ article.likes|length }}</span>
                </p>

                <!-- Bouton Like -->
                <button id="like-button-{{ article.id }}" data-article-id="{{ article.id }}" class="like-button mt-2 px-4 py-2 bg-blue-500 text-white rounded">
                    {% if app.user and app.user in article.likes %}
                        Unlike
                    {% else %}
                        Like
                    {% endif %}
                </button>

                <!-- Bouton de suppression (si l'utilisateur est l'auteur) -->
                {% if app.user and app.user.id == article.user.id %}
                    <form action="{{ path('article_delete', { id: article.id }) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette publication ?')" class="mt-4">
                        <button type="submit" class="w-50 py-2 px-4 bg-red-500 text-white rounded-lg hover:bg-red-200 focus:outline-none transition">Supprimer</button>
                    </form>
                {% endif %}
            </div>
        </div>
        {% else %}
            <p class="col-span-full text-center text-gray-600">Aucun article trouvé.</p>
        {% endfor %}
    </div>
</div>

<script>
    document.querySelectorAll('.like-button').forEach(button => {
        button.addEventListener('click', function() {
            const articleId = this.dataset.articleId;
            fetch(`/article/${articleId}/like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
            .then(response => response.json())
            .then(data => {
                // Mettre à jour le nombre de likes affiché
                document.getElementById(`like-count-${articleId}`).textContent = data.likes;
                // Changer le texte du bouton
                this.textContent = data.likes === 0 ? 'Like' : 'Unlike';
            });
        });
    });
    
</script>
{% endblock %}
