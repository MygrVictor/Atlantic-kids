{% extends 'base.html.twig' %}

{% block body %}
    <div class="max-w-4xl mx-auto p-6 bg-white shadow-lg rounded-lg">
        <h1 class="text-3xl font-semibold text-gray-800 text-center mb-6">Créer une publication</h1>

        {{ form_start(form) }}
        
        <!-- Titre de la publication -->
        <div class="mb-4">
            {{ form_row(form.title, {
                'label': 'Titre',
                'attr': {'class': 'w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500'}
            }) }}
            {{ form_errors(form.title) }}
        </div>

        <!-- Contenu de la publication -->
        <div class="mb-4">
            {{ form_widget(form.content, {
                'attr': {'class': 'w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500', 'placeholder': 'Écrivez votre contenu ici...'}
            }) }}
            {{ form_errors(form.content) }}
        </div>

        <!-- Tags -->
        <div class="mb-4">
            <label class="block text-gray-700 font-medium mb-2">Tags</label>
            <div class="relative">
                {{ form_widget(form.tags, {
                    'attr': {'class': 'w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500'}
                }) }}
                {{ form_errors(form.tags) }}
            </div>
        </div>

        <!-- Image -->
        <div class="mb-4">
            {{ form_row(form.image, {
                'attr': {'class': 'w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500'}
            }) }}
            {{ form_errors(form.image) }}
        </div>

        <!-- Bouton de soumission -->
        <div class="text-center">
            {{ form_row(form.submit, {
                'attr': {'class': 'w-full bg-blue-500 text-white p-2 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500'}
            }) }}
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
