{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
<div class="ml-64 p-6 max-w-4xl mx-auto bg-white shadow-lg rounded-lg">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">{{ article.title }}</h1>
    
    <div class="text-gray-600 text-sm mb-4">
        <p><strong class="font-semibold">Auteur :</strong> {{ article.user.username }}</p>
        <p><strong class="font-semibold">Publié le :</strong> {{ article.createdAt|date('d-m-Y') }}</p>
    </div>

    <div class="border-t border-gray-300 py-4">
        <h2 class="text-xl font-semibold text-gray-800 mb-2">Contenu de l'article :</h2>
        <p class="text-gray-700 leading-relaxed">{{ article.content }}</p>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_article') }}" class="inline-block px-4 py-2 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-700 transition">
            ← Retour à la liste des articles
        </a>
    </div>
</div>
{% endblock %}
