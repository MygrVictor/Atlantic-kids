{# article/show.html.twig #}

{% extends 'base.html.twig' %}

{% block body %}
<div class="ml-64 p-4">
    <h1>{{ article.title }}</h1>
    <p>{{ article.content }}</p>

    <p>Likes: <span id="like-count-{{ article.id }}">{{ article.likes|length }}</span></p>
    <button id="like-button-{{ article.id }}" data-entity="article" data-id="{{ article.id }}" class="like-button">
        {% if app.user and app.user in article.likes %}
            Unlike
        {% else %}
            Like
        {% endif %}
    </button>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.querySelectorAll('.like-button').forEach(button => {
        button.addEventListener('click', function() {
            const entity = this.dataset.entity;
            const id = this.dataset.id;
            fetch(`/like/${entity}/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById(`like-count-${id}`).textContent = data.likes;
                this.textContent = data.likes === 0 ? 'Like' : 'Unlike';
            });
        });
    });
</script>
{% endblock %}
