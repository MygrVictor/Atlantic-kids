{% extends 'base.html.twig' %}

{% block body %}
<div class="ml-64 p-4">
    <div class="mx-auto p-4 max-w-3xl">
        <h1 class="text-3xl font-bold mb-4">{{ article.title }}</h1>
        <p class="text-gray-700 mb-6">{{ article.content }}</p>

        <div class="flex items-center space-x-4 mb-6">
            <p class="text-gray-600">Likes: <span id="like-count-{{ article.id }}" class="font-semibold">{{ article.likes|length }}</span></p>
            <button id="like-button-{{ article.id }}" data-entity="article" data-id="{{ article.id }}" class="like-button px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                {% if app.user and app.user in article.likes %}
                    Unlike
                {% else %}
                    Like
                {% endif %}
            </button>
        </div>

        <h3 class="text-2xl font-semibold mb-4">Commentaires</h3>

        {# Afficher les commentaires existants #}
        {% for comment in comments %}
            <div class="comment mb-4 p-4 border rounded shadow">
                <p class="text-gray-800"><strong>{{ comment.user.username }}</strong> - {{ comment.createdAt|date('d/m/Y') }}</p>
                <p class="text-gray-600">{{ comment.content }}</p>
            </div>
        {% endfor %}

        {# Formulaire pour ajouter un commentaire #}
        {% if app.user %}
            <h4 class="text-xl font-semibold mb-2">Ajouter un commentaire</h4>
            <form method="POST" action="{{ path('article_show', {'id': article.id}) }}">
                {{ form_start(commentForm) }}
                {{ form_widget(commentForm) }}
                <button type="submit">Ajouter un commentaire</button>
                {{ form_end(commentForm) }}
            </form>
        {% else %}
            <p class="text-red-500">Vous devez être connecté pour ajouter un commentaire.</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    document.querySelectorAll('.like-button').forEach(button => {
        button.addEventListener('click', function() {
            const entity = this.dataset.entity;
            const id = this.dataset.id;
            fetch(`/like/${entity}/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById(`like-count-${id}`).textContent = data.likes;
                this.textContent = data.likes === 0 ? 'Like' : 'Unlike';
            });
        });
    });
</script>
{% endblock %}